<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/AppBackgroundColor"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="40dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Health Profile"
            android:textColor="@color/PrimaryTextColor"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Keep your health details up to date"
            android:textColor="@color/colorOnBackground"
            android:textSize="13sp"
            android:layout_marginBottom="24dp" />

        <!-- Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/CardBackground"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Body Condition -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BODY CONDITION"
                    android:textColor="@color/colorPrimary"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@color/SurfaceColor"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="4dp"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_body"
                        android:tint="@color/colorOnBackground" />

                    <EditText
                        android:id="@+id/editBodyCondition"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g. Fit, Slightly weak"
                        android:hintTextColor="@color/HintTextColor"
                        android:textColor="@color/PrimaryTextColor"
                        android:background="@android:color/transparent"
                        android:inputType="text"
                        android:layout_marginStart="10dp"
                        android:paddingVertical="10dp" />
                </LinearLayout>

                <!-- Blood Pressure -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BLOOD PRESSURE"
                    android:textColor="@color/colorPrimary"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@color/SurfaceColor"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="4dp"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_bp"
                        android:tint="@color/colorOnBackground" />

                    <EditText
                        android:id="@+id/editBloodPressure"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g. 120/80 mmHg"
                        android:hintTextColor="@color/HintTextColor"
                        android:textColor="@color/PrimaryTextColor"
                        android:background="@android:color/transparent"
                        android:inputType="text"
                        android:layout_marginStart="10dp"
                        android:paddingVertical="10dp" />
                </LinearLayout>

                <!-- Sugar Level -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SUGAR LEVEL"
                    android:textColor="@color/colorPrimary"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@color/SurfaceColor"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="4dp"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_sugar"
                        android:tint="@color/colorOnBackground" />

                    <EditText
                        android:id="@+id/editSugarLevel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g. 110 mg/dL"
                        android:hintTextColor="@color/HintTextColor"
                        android:textColor="@color/PrimaryTextColor"
                        android:background="@android:color/transparent"
                        android:inputType="numberDecimal"
                        android:layout_marginStart="10dp"
                        android:paddingVertical="10dp" />
                </LinearLayout>

                <!-- Diseases -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CURRENT DISEASES"
                    android:textColor="@color/colorPrimary"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@color/SurfaceColor"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="4dp"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_die"
                        android:tint="@color/colorOnBackground" />

                    <EditText
                        android:id="@+id/editDiseases"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="List any current conditions"
                        android:hintTextColor="@color/HintTextColor"
                        android:textColor="@color/PrimaryTextColor"
                        android:background="@android:color/transparent"
                        android:inputType="text"
                        android:layout_marginStart="10dp"
                        android:paddingVertical="10dp" />
                </LinearLayout>

                <!-- Blood Group -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BLOOD GROUP"
                    android:textColor="@color/colorPrimary"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@color/SurfaceColor"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="4dp"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_blood_group"
                        android:tint="@color/colorOnBackground" />

                    <EditText
                        android:id="@+id/editBloodGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g. A+, O-"
                        android:hintTextColor="@color/HintTextColor"
                        android:textColor="@color/PrimaryTextColor"
                        android:background="@android:color/transparent"
                        android:inputType="text"
                        android:layout_marginStart="10dp"
                        android:paddingVertical="10dp" />
                </LinearLayout>

                <!-- Medicines -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="REGULAR MEDICINES"
                    android:textColor="@color/colorPrimary"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@color/SurfaceColor"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="4dp"
                    android:layout_marginBottom="8dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_medicine"
                        android:tint="@color/colorOnBackground" />

                    <EditText
                        android:id="@+id/editMedicines"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g. Paracetamol, Vitamin D"
                        android:hintTextColor="@color/HintTextColor"
                        android:textColor="@color/PrimaryTextColor"
                        android:background="@android:color/transparent"
                        android:inputType="text"
                        android:layout_marginStart="10dp"
                        android:paddingVertical="10dp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Save Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveHealthInfoButton"
            style="@style/Widget.NeuroNudge.Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Save Health Info"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
